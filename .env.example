# ─── DATABASE ───────────────────────────────────────────
DATABASE_URL=postgresql://qfx_user:STRONG_PASSWORD@postgres:5432/qfx_db
DB_PASSWORD=STRONG_PASSWORD

# ─── REDIS ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET_2
TWO_FACTOR_SECRET=REPLACE_WITH_32_CHAR_SECRET

# ─── STRIPE ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE

# ─── CRYPTO APIs ────────────────────────────────────────
COINGECKO_API_KEY=REPLACE
BINANCE_API_KEY=REPLACE
BINANCE_API_SECRET=REPLACE

# ─── WEB3 ───────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=REPLACE

# ─── ADMIN ──────────────────────────────────────────────
ADMIN_EMAIL=admin@qfx-finance.com
ADMIN_PASSWORD=REPLACE_STRONG_PASSWORD
PLATFORM_WALLET_ADDRESS=REPLACE

# ─── APP ────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
NEXT_PUBLIC_API_URL=https://api.qfx-finance.com
NEXT_PUBLIC_WS_URL=wss://api.qfx-finance.com
NEXT_PUBLIC_ADMIN_SECRET=REPLACE
