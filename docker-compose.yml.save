services:
  postgres:
    image: postgres:16-alpine
    container_name: qfx_postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: qfx_db
      POSTGRES_USER: qfx_user
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - qfx_network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U qfx_user -d qfx_db"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: qfx_redis
    restart: unless-stopped
    command: redis-server --appendonly yes
    volumes:
      - redis_data:/data
    networks:
      - qfx_network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 3

  api:
    build:
      context: .
      dockerfile: apps/api/Dockerfile
    container_name: qfx_api
    restart: unless-stopped
    env_file: .env
    environment:
      NODE_ENV: production
      DATABASE_URL: postgresql://qfx_user:${DB_PASSWORD}@postgres:5432/qfx_db
      REDIS_URL: redis://redis:6379
      PORT: 3001
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - qfx_network
  ports:
  - "127.0.0.1:3000:3000"

  client:
    build:
      context: .
      dockerfile: apps/client/Dockerfile
    container_name: qfx_client
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: 3000
      HOSTNAME: 0.0.0.0
    depends_on:
      - api
    networks:
      - qfx_network
   ports:
  - "127.0.0.1:3000:3000"

  admin:
    build:
      context: .
      dockerfile: apps/admin/Dockerfile
    container_name: qfx_admin
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: 3002
      HOSTNAME: 0.0.0.0
    depends_on:
      - api
    networks:
      - qfx_network
   ports:
  - "127.0.0.1:3000:3000"
networks:
  qfx_network:
    driver: bridge

volumes:
  postgres_data:
  redis_data:
